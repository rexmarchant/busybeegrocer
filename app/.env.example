VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Leave blank locally: with no DSN, error reporting stays
# console-only and the Sentry SDK is tree-shaken out of the build entirely,
# so dev crashes never reach the real project or spend its quota.
# Set in CI (GitHub Actions secret) for deployed builds.
VITE_SENTRY_DSN=
