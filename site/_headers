# Content-hashed filenames can be cached forever -- that is the entire point of
# hashing them. GitHub Pages forced max-age=600 on everything, so every visitor
# re-validated the whole bundle every ten minutes.
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache these: the service worker and the HTML it registers from are how
# an update reaches anyone. A stale copy pins people to an old build.
/app/index.html
  Cache-Control: public, max-age=0, must-revalidate
/app/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/app/registerSW.js
  Cache-Control: public, max-age=0, must-revalidate
/app/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Large, rarely changed, and content-addressed by name in practice.
/app/video/*
  Cache-Control: public, max-age=604800
/app/screenshots/*
  Cache-Control: public, max-age=604800

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The SPA fallback is a copy of the app's index.html, served for every
# client-side route under /app/. It has to go stale just as readily, or deep
# links would keep booting an old bundle after a deploy.
/app/404.html
  Cache-Control: public, max-age=0, must-revalidate
